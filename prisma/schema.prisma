generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HubContact {
  id                  String           @id @default(cuid())
  name                String           @unique
  emoji               String           @default("👤")
  country             String?
  isArchived          Boolean          @default(false)
  heldBalanceUsd      Float            @default(0)
  receivableBalanceUsd Float           @default(0)
  payableBalanceUsd    Float            @default(0)
  netPositionUsd      Float            @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  transactions        HubTransaction[] @relation("ContactTransactions")
  reminders           HubReminder[]    @relation("ContactReminders")

  @@index([name])
  @@index([isArchived])
}

model HubCurrency {
  id        String   @id @default(cuid())
  code      String   @unique
  symbol    String
  rateToUsd Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HubCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isCustom  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HubTransaction {
  id             String           @id @default(cuid())
  amount         Float
  currencyCode   String           @default("USD")
  amountInUsd    Float
  contactId      String
  contact        HubContact       @relation("ContactTransactions", fields: [contactId], references: [id], onDelete: Cascade)
  type           String           // "HELD", "RECEIVABLE", "PAYABLE"
  category       String
  note           String?
  photoPath      String?
  attachmentName String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([contactId])
  @@index([type])
  @@index([createdAt])
}

model HubReminder {
  id            String     @id @default(cuid())
  amount        Float
  currencyCode  String     @default("USD")
  amountInUsd   Float
  contactId     String
  contact       HubContact @relation("ContactReminders", fields: [contactId], references: [id], onDelete: Cascade)
  dueDate       DateTime
  note          String?
  reminderEmail String?
  plannedType   String     @default("RECEIVABLE") // "HELD" (encaisser), "PAYABLE" (décaisser), "RECEIVABLE" (rappel simple)
  lastNotifiedAt DateTime?
  isCompleted    Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([contactId])
  @@index([dueDate])
  @@index([isCompleted])
}

model HubAuditTrail {
  id            String   @id @default(cuid())
  entityType    String   // "TRANSACTION", "CONTACT", "REMINDER", "SETTING", "USER"
  entityId      String?
  action        String   // "CREATE", "UPDATE", "DELETE", "WIPE", "LOGIN"
  details       String?  // Description textuelle riche
  oldValue      String?  // Valeur avant modif (JSON ou texte)
  newValue      String?  // Valeur après modif (JSON ou texte)
  modifiedBy    String   // Nom de l'utilisateur
  createdAt     DateTime @default(now())

  @@index([entityType])
  @@index([createdAt])
  @@index([modifiedBy])
}

model HubUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("assistant") // "admin" or "assistant"
  canWrite     Boolean  @default(true)
  canEdit      Boolean  @default(false)
  canDelete    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HubTndMovement {
  id          String   @id @default(cuid())
  amount      Float    // Montant brut en TND
  type        String   // "IN" (Entrée), "OUT" (Sortie)
  note        String   // Note obligatoire pour la traçabilité
  performedBy String   // Nom de l'utilisateur ayant saisi le mouvement
  scheduledFor DateTime? // Si défini : mouvement PLANIFIÉ pour une date future
  isSettled   Boolean  @default(true) // false = en attente (pas encore dans le solde)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([type])
  @@index([scheduledFor])
  @@index([isSettled])
}

// ARCHIVE ledger — independent cash account mirroring the TND treasury,
// but a separate box (its own movements, balance, history). Admin-only.
model HubArchiveMovement {
  id          String   @id @default(cuid())
  amount      Float    // Montant brut en TND
  type        String   // "IN" (Entrée), "OUT" (Sortie)
  note        String   // Note obligatoire pour la traçabilité
  performedBy String   // Nom de l'utilisateur ayant saisi le mouvement
  scheduledFor DateTime? // Si défini : mouvement PLANIFIÉ pour une date future
  isSettled   Boolean  @default(true) // false = en attente (pas encore dans le solde)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([type])
  @@index([scheduledFor])
  @@index([isSettled])
}

// Informal money notes per partner — money owed in either direction that must stay
// VISIBLE (partner card + DEVISES) but is NEVER counted in any balance/total.
// Independent additive table, provisioned via CREATE TABLE IF NOT EXISTS (zero risk).
model HubPartnerNote {
  id           String   @id @default(cuid())
  contactId    String
  direction    String   // "THEY_OWE" (il me doit) or "I_OWE" (je lui dois)
  amount       Float     @default(0)
  currencyCode String    @default("TND")
  text         String
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([contactId])
}

// BANQUE — multiple named bank accounts, each an independent cash box mirroring the TND
// treasury (its own movements/balance/history). Visible to assistants (like Trésorerie).
// Additive tables provisioned via CREATE TABLE IF NOT EXISTS (zero risk).
model HubBankAccount {
  id           String   @id @default(cuid())
  name         String
  currencyCode String   @default("TND")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sortOrder])
}

model HubBankMovement {
  id          String   @id @default(cuid())
  accountId   String
  amount      Float
  type        String   // "IN" (Entrée), "OUT" (Sortie)
  note        String
  performedBy String
  scheduledFor DateTime?
  isSettled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accountId])
  @@index([createdAt])
  @@index([scheduledFor])
  @@index([isSettled])
}

// Singleton global security state. id is always "global".
// lockEpoch invalidates every signed cookie each time the lock changes state.
model HubPanicLock {
  id                    String   @id @default("global")
  isLocked              Boolean  @default(false)
  emergencyUsername     String?
  emergencyPasswordHash String?
  lockedAt              DateTime?
  lockedBy              String?
  lockEpoch             Int      @default(0)
  updatedAt             DateTime @updatedAt

  @@index([isLocked])
}

// CREDIT — money we must pay at some point in the future, with NO due date required.
// Deliberately and completely INDEPENDENT: never summed into any other balance, total,
// sale, payment or calculation anywhere in the platform. Marking an entry PAID removes it
// from the active CREDIT total but KEEPS the row as history (never deleted).
// Additive table provisioned via CREATE TABLE IF NOT EXISTS (zero risk).
model HubCredit {
  id           String    @id @default(cuid())
  amount       Float
  currencyCode String    @default("TND")
  beneficiary  String    // Nom / bénéficiaire à payer
  note         String    // Description / motif
  isPaid       Boolean   @default(false)
  paidAt       DateTime?
  paidBy       String?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isPaid])
  @@index([createdAt])
}

